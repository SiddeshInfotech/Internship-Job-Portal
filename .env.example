# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it's already in .gitignore.

# ---- Database (MySQL) ----
# NOTE: if this runs on the same DB as the student backend, use the
# same DB_HOST/DB_USER/DB_PASSWORD/DB_NAME — this backend creates its
# own separate tables (clients, client_password_resets,
# client_otp_verifications) so there's no collision with student data.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=placement_portal_db
DB_CHARSET=utf8mb4

# ---- App ----
SECRET_KEY=change-this-to-something-random
DEBUG=True
# Different port than the student backend (5000) so both can run
# at the same time on one machine during testing.
PORT=5001

# ---- Email (Gmail SMTP) ----
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
